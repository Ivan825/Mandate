# ---- Required ----
DATABASE_URL=postgres://mandate:mandate@localhost:5432/mandate   # Neon/any Postgres in production
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
NEXT_PUBLIC_BASE_URL=http://localhost:3000                       # public URL: sign-in links, OAuth, MCP discovery

# ---- Sign-in (all optional; email links print to the console without Resend) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM="Mandate <sign-in@yourdomain.com>"

# ---- Notifications (optional) ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=
# NOTIFY_SECRET=long-random-string      # signs one-tap approve/deny links
# APPROVAL_TTL_HOURS=24

# ---- Stripe Issuing (optional; test-mode keys work) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2025-02-24.acacia

# ---- Dev only ----
# ALLOW_SEED=1
