# Local dev: a SQLite file. Production (Vercel): a Turso/libSQL URL + token.
DATABASE_URL="file:./data/mandate.db"
# DATABASE_AUTH_TOKEN=
# Optional: live Stripe Issuing (test-mode keys work)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: single-password protection for the dashboard
# ADMIN_PASSWORD=change-me

# Notifications (optional). Pending approvals are pushed with Approve/Deny buttons.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/mandate
# NOTIFY_SECRET=long-random-string   # signs one-tap links; defaults to ADMIN_PASSWORD
# APPROVAL_TTL_HOURS=24              # unanswered requests expire after this
# NEXT_PUBLIC_BASE_URL=http://localhost:3000   # used in links sent to you
