{
  "name": "mandate",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/policy.test.ts tests/proxy.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "auth:generate": "AUTH_GEN=1 npx @better-auth/cli@latest generate --config lib/auth.ts --output lib/auth-schema.ts --adapter drizzle --dialect postgresql -y",
    "test:integration": "tsx --test tests/service.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "preflight": "node scripts/preflight.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.5",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@better-auth/mcp": "^1.7.5",
    "@better-auth/passkey": "^1.7.5",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.25",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0",
    "stripe": "^17.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "description": "Scoped, revocable spending authority for AI agents: limits, approvals, a signed ledger, and revocation \u2014 over MCP, an API-key proxy, REST tokens or virtual cards.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivan825/Mandate.git"
  },
  "homepage": "https://mandate-ashen.vercel.app",
