# Copy to deploy/ecs/params.env (git-ignored) and fill in.
VPC_ID=vpc-0123456789abcdef0                      # aws ec2 describe-vpcs --filters Name=is-default,Values=true
SUBNET_IDS=subnet-aaaa,subnet-bbbb                # two+ subnets of that VPC: aws ec2 describe-subnets --filters Name=vpc-id,Values=$VPC_ID
VPC_CIDR=172.31.0.0/16
HOSTNAME_=mandate.example.com                     # your domain name for the app (underscore avoids clashing with the shell's HOSTNAME)
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...
LEGAL_OPERATOR_NAME="Your name"
LEGAL_CONTACT_EMAIL=you@example.com
OPERATOR_EMAILS=you@example.com
DESIRED_COUNT=1
CPU=512
MEMORY=1024
DB_INSTANCE_CLASS=db.t4g.micro
